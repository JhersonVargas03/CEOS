# ============================================================
# CEOS Backend — Variables de Entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# ── Django Core ────────────────────────────────────────────
# Genera una nueva con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-ceos-backend-super-secret-key-2026

# En producción: False
DEBUG=True

# En producción: tu-dominio.koyeb.app,otro-dominio.com
ALLOWED_HOSTS=*

# ── Base de datos ──────────────────────────────────────────
# LOCAL: dejar vacío → usa SQLite automáticamente
# PRODUCCIÓN (Neon): postgresql://usuario:password@ep-xxx.neon.tech/ceos?sslmode=require
DATABASE_URL=

# ── CORS (origenes permitidos para la app Flutter/Web) ────
# LOCAL: dejar vacío → CORS_ALLOW_ALL_ORIGINS = True
# PRODUCCIÓN: https://tu-app.koyeb.app,https://tu-dominio.com
CORS_ALLOWED_ORIGINS=

# ── CSRF Trusted Origins ───────────────────────────────────
# PRODUCCIÓN: https://tu-app.koyeb.app
CSRF_TRUSTED_ORIGINS=

# ── Superusuario inicial (solo para primer despliegue) ────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@clinica.com
DJANGO_SUPERUSER_PASSWORD=Admin1234!

# ── Telegram Bot API ───────────────────────────────────────
# 1. Abre Telegram → @BotFather → /newbot
# 2. Copia el token HTTP API proporcionado
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_mock_token
TELEGRAM_BOT_NAME=Ceos_Clibot
TELEGRAM_WEBHOOK_SECRET=ceos_telegram_secret_token_key_2026
