# CEOS System Configuration Environment Variables

# Django Core
SECRET_KEY=django-insecure-ceos-backend-super-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=*

# Credenciales del Superusuario inicial para desarrollo local
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@clinica.com
DJANGO_SUPERUSER_PASSWORD=Admin1234!

# Telegram Bot API Configuration
# Para obtener tu token real:
# 1. Abre Telegram y busca @BotFather
# 2. Envía /newbot y sigue las instrucciones para ponerle nombre a tu bot (ej. CEOS_Clinica_Bot)
# 3. Copia el HTTP API Token proporcionado por @BotFather y pégalo abajo en TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_mock_token
TELEGRAM_BOT_NAME=Ceos_Clibot
TELEGRAM_WEBHOOK_SECRET=ceos_telegram_secret_token_key_2026

