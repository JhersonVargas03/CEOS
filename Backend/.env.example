# ============================================================
# CEOS Backend — Variables de Entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# ── Django Core ────────────────────────────────────────────
# Genera una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-ceos-backend-super-secret-key-2026

# En producción: False
DEBUG=True

# En producción: tu-dominio.render.com,tu-dominio.com
ALLOWED_HOSTS=*

# ── Base de datos ──────────────────────────────────────────
# LOCAL: dejar vacío → usa SQLite automáticamente
#
# PRODUCCIÓN (Supabase - recomendado):
#   URL directa (dev):  postgresql://postgres:[pass]@db.[ref].supabase.co:5432/postgres?sslmode=require
#   URL pooler (prod):  postgresql://postgres.[ref]:[pass]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# PRODUCCIÓN (Neon - legacy):
#   postgresql://usuario:password@ep-xxx.neon.tech/ceos?sslmode=require
DATABASE_URL=

# Tiempo de vida de conexiones en segundos (0=nueva por request, 60=persistente)
# En Supabase con pooler usa 0; con conexión directa usa 60
DB_CONN_MAX_AGE=0

# ── CORS (orígenes permitidos para la app Flutter/Web) ────
# LOCAL: dejar vacío → CORS_ALLOW_ALL_ORIGINS = True
# PRODUCCIÓN: https://tu-app.render.com
CORS_ALLOWED_ORIGINS=

# ── CSRF Trusted Origins ───────────────────────────────────
# PRODUCCIÓN: https://tu-app.render.com
CSRF_TRUSTED_ORIGINS=

# ── Superusuario inicial (solo para primer despliegue) ────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@clinica.com
DJANGO_SUPERUSER_PASSWORD=Admin1234!

# ── Telegram Bot API ───────────────────────────────────────
# 1. Abre Telegram → @BotFather → /newbot
# 2. Copia el token HTTP API proporcionado
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_mock_token
TELEGRAM_BOT_NAME=Ceos_Clibot
TELEGRAM_WEBHOOK_SECRET=ceos_telegram_secret_token_key_2026

# ── Rate Limiting / Throttling ─────────────────────────────
# Estos valores están en settings.py como defaults, solo sobreescribir si necesitas ajustar
# THROTTLE_ANON=60/min
# THROTTLE_USER=300/min

# ── Cron HTTP (Alertas de inventario sin Celery Beat) ──────
# Secreto enviado en el header X-Cron-Secret al hacer POST /api/inventario/cron/revisar-alertas
CRON_SECRET=
